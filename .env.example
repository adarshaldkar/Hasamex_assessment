# LLM API Key (OpenAI or Google Gemini)
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Model Configuration
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
VECTOR_STORE_PATH=./storage/chroma
PROCESSED_DATA_PATH=./storage/processed
